GROQ_API_KEY=your_groq_api_key_here
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-90b-vision-preview

# Cloud database — use Supabase SESSION POOLER (port 6543), NOT direct (5432)
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> Session pooler -> URI
DATABASE_URL=postgresql://postgres.your-ref:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase JWT secret (Settings -> API -> JWT Secret)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret